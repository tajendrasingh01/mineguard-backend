# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=4000

# Supabase project Settings -> API. Backend-only service role key; never expose in browser.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=replace_with_service_role_key

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be a unique random secret of at least 32 characters.
JWT_SECRET=replace_with_a_unique_64_character_random_secret

# Exact HTTPS frontend origin(s), comma-separated only when you explicitly trust each origin.
# No trailing slash. In production, this is required and no wildcard is accepted.
FRONTEND_URL=https://your-app.vercel.app
